# .env.example
# Copy this file to .env for local development
# Never commit actual .env file to version control!

# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
# For production:
# VITE_API_URL=https://api.urbannest.com/api/v1

# App Configuration
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=UrbanNEST

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT=false
VITE_ENABLE_BOOSTS=true
VITE_ENABLE_PAYMENT_GATEWAY=false

# Third-Party Services
# Get your API keys from respective service providers:
# - Google Maps: https://console.cloud.google.com
# - Stripe: https://dashboard.stripe.com
# - Chapa: https://dashboard.chapa.co

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Processing
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
VITE_CHAPA_PUBLIC_KEY=your_chapa_public_key_here

# Analytics
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Security Settings
VITE_SESSION_TIMEOUT=3600
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_TOKEN_REFRESH_INTERVAL=300000

# Debug Mode (set to false in production)
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error